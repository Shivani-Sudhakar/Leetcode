class Solution {
    public List<Integer> getRow(int rowIndex) {
        /*Approach: Use the formula insert*(rowindex-1)/(col+1)*/
        //TC: O(n)
        //SC: O(n)
        List<Integer> ans=new ArrayList<>();

        long insert=1;
        ans.add((int)insert);
        for(int i=0;i<rowIndex;i++){
            insert=insert*(rowIndex-i);
            insert=insert/(i+1);
            ans.add((int)insert);
        }

        return ans;
    }
}
