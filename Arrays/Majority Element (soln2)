class Solution {
    public int majorityElement(int[] nums) {
        /*Approach: take the first element as candidate and set count to 0. while traversing the array, if the element is same as candidate, increment count. else, decrement it. if count is 0, set the next element as the new candidate*/
        //TC: O(n)
        //SC:O(1)
        int candidate=nums[0];
        int count=0;
        for(int i=0;i<nums.length;i++){
            if(nums[i]==candidate){
                count++;
            }
            else{
                count--;
                if(count==0){
                    candidate=nums[i+1];
                }
            }
        }
        return candidate;
    }
}
