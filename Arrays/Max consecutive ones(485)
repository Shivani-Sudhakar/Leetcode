class Solution {
    public int findMaxConsecutiveOnes(int[] nums) {
        /*Approach: take 2 variables length and maxLength. if nums[i] is 1, increment length. 
         else, maxLength is set to length and length is set back to 0. return maxLength*/
        //TC: O(n);
        //SC: O(1);
        int length=0;
        int maxLength=0;
        for (int i=0;i<nums.length;i++){
            if(nums[i]==1){
                length++;
            }
            else{
                maxLength=Math.max(length, maxLength);
                length=0;
            }
        }
        maxLength=Math.max(length, maxLength);
        return maxLength;
    }
}
