class Solution {
    public int maxSubArray(int[] nums) {
        /*Approach: Kadane's Algorithm. Maintain 2 variables sum and maxSum. sum is the maximum element between the current number and sum+current number.
        MaxSum is the maximum element of the sum and MaxSum. Return MaxSum*/
        //TC: O(n)
        //SC:O(1)
        int sum=nums[0];
        int maxSum=nums[0];
        for(int i=1;i<nums.length;i++){
            sum=Math.max(nums[i],sum+nums[i]);
            maxSum=Math.max(sum,maxSum);
        }
        return maxSum;
    }
}
