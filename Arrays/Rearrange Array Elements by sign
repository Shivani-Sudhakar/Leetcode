class Solution {
    public int[] rearrangeArray(int[] nums) {
        /*Approach: Take pos and neg variables as index. pos=0 and neg=1. Create a new array. 
        if an element is positive, add it to answer and increment positive by 2. same for negative.*/
        //TC:O(n)
        //SC:O(n)
        int pos=0;
        int neg=1;
        int[] answer=new int[nums.length];
        for(int i=0;i<nums.length;i++){
            if(nums[i]>0){
                answer[pos]=nums[i];
                pos+=2;
            }
            else{
                answer[neg]=nums[i];
                neg+=2;
            }
        }
        return answer;
    }
}
