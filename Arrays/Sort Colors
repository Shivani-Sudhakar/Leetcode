class Solution {
    public void sortColors(int[] nums) {
        /*Approach: Dutch National Flag approach. In this, we have 3 rules
        0->low-1: 0
        low->mid-1: 1
        mid->high: unsorted
        high+1->n-1: 2
        Refer to video.*/
        //TC: O(n)
        //SC: O(1)
        int n=nums.length;
        int low=0;
        int mid=0;
        int high=n-1;
        int temp=0;
        while(mid<=high){
            if(nums[mid]==0){
                temp=nums[low];
                nums[low]=nums[mid];
                nums[mid]=temp;
                low++;
                mid++;
            }
            else if(nums[mid]==1){
                mid++;
            }
            else if(nums[mid]==2){
                temp=nums[mid];
                nums[mid]=nums[high];
                nums[high]=temp;
                high--;
            }
        }
    }
}
